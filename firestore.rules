rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function admin(){return request.auth!=null&&exists(/databases/$(d)/documents/admins/$(request.auth.uid));}
 match /{c}/{id}{
  allow read:if c in ['products','qualities','categories','settings']||(c=='admins'&&request.auth!=null&&request.auth.uid==id);
  allow write:if admin()&&c!='admins';}
 match /orders/{id}{
  allow create:if request.resource.data.status=='Pending'&&request.resource.data.paid==false&&request.resource.data.customer.name is string&&request.resource.data.items.size()>0&&request.resource.data.items.size()<=30;
  allow read,update,delete:if admin();}
}}
